# The home page is index.php (it includes the shared header/footer).
# index.html is only a forwarding stub for old links.
DirectoryIndex index.php index.html

# Make browsers revalidate the front-end files on every load so edits to
# the .js / .css files show up without a hard refresh. Unchanged files
# still come back as a cheap 304 Not Modified (via ETag/Last-Modified).
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Settings files hold API keys; never serve them, even as empty output.
<FilesMatch "^config\.(local|example)\.php$">
    Require all denied
</FilesMatch>
